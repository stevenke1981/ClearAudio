{
  "manifest_version": 3,
  "name": "Clear Audio 單分頁錄音",
  "version": "0.4.0",
  "minimum_chrome_version": "116",
  "description": "一鍵錄成 MP3：只錄經點擊授權的分頁音訊並存檔（另含 WAV 控制台）。不錄麥克風、不連網。",
  "permissions": ["activeTab", "tabCapture", "offscreen", "downloads"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "將此分頁錄成 MP3"
  },
  "commands": {
    "toggle-mp3": {
      "suggested_key": {"default": "Alt+Shift+R"},
      "description": "開始／停止將目前分頁錄成 MP3"
    }
  },
  "background": { "service_worker": "background.js", "type": "module" }
}
